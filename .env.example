# Copy to .env and fill in the keys you have. The app runs with none of them
# set: ANALYZER=heuristic never calls a model.

# heuristic | ollama | backboard | tinker
ANALYZER=heuristic
DATABASE_URL=sqlite:///./duster.db

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Open-weight models only. Backboard defaults to a closed model if the
# provider is omitted, so this app refuses anything except an open provider.
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_LLM_PROVIDER=openrouter
BACKBOARD_MODEL=qwen/qwen-2.5-7b-instruct

# Short names also work: llama-3.1-8b-instruct, qwen2.5-7b-instruct, mistral-7b-instruct
# COMPARE_MODELS=llama-3.1-8b-instruct,qwen2.5-7b-instruct,mistral-7b-instruct

TINKER_API_KEY=
TINKER_MODEL_NAME=

# faster-whisper size. base is the CPU default. Audio never leaves the machine.
WHISPER_MODEL=base
